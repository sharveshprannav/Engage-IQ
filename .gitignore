# ==========================================
# EngageAI — Root .gitignore
# ==========================================

# ── Environment & Secrets ──────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.crt
secrets/

# Keep environment examples
!.env.example
!.env.test.example

# ── Database & Local Storage ──────────────
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
engageai.db
backend/engageai.db
data/
chroma_data/
chroma_db/
vector_store/

# ── Python / Backend ──────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
backend/venv/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/
.ruff_cache/
.mypy_cache/

# ── Node.js / Frontend ────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
dist/
.vite/
frontend/.vite/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── IDEs & Operating Systems ──────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# VS Code / JetBrains / Editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# ── Temporary & Scratch Files ─────────────
tmp/
temp/
scratch/
.system_generated/
