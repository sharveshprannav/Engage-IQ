# ╔══════════════════════════════════════════════════════════════════╗
# ║                  EngageAI Environment Variables                 ║
# ║  Copy this file to .env and fill in production values           ║
# ╚══════════════════════════════════════════════════════════════════╝

# ─── Application ────────────────────────────────────────────────────
APP_ENV=development                    # development | staging | production
APP_NAME=EngageAI
DEBUG=true                             # Set false in production
LOG_LEVEL=info                         # debug | info | warning | error
SECRET_KEY=change-me-to-a-random-64-char-string    # REQUIRED in production

# ─── PostgreSQL ─────────────────────────────────────────────────────
POSTGRES_USER=engageai
POSTGRES_PASSWORD=engageai_secret      # REQUIRED: Change in production
POSTGRES_DB=engageai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://engageai:engageai_secret@localhost:5432/engageai

# ─── Redis ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# ─── ChromaDB ──────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ─── JWT Authentication ────────────────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret-key-64-chars   # REQUIRED in production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Server ────────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000
UVICORN_WORKERS=2
CELERY_CONCURRENCY=4

# ─── AI / LLM Provider ────────────────────────────────────────────
# Leave blank to use local heuristic/rule-based fallbacks (fully offline)
# Set to enable LLM-backed features (summarization, NL query, insights, AI Assistant)
GEMINI_API_KEY=                         # Google Gemini API key
GEMINI_MODEL=gemini-3.6-flash           # Recommended: gemini-2.0-flash or gemini-1.5-flash
AI_PROVIDER=gemini                      # gemini | openai | anthropic
OPENAI_API_KEY=                         # TODO(production): Set your OpenAI API key
OPENAI_MODEL=gpt-4o-mini               # Model for generative tasks
ANTHROPIC_API_KEY=                      # Alternative LLM provider
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Embedding model (local sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2       # Local model, no API key needed
EMBEDDING_DIMENSION=384

# AI Feature Flags
AI_USE_LLM=true                        # Set true when API key is configured
AI_FALLBACK_ENABLED=true               # Always fall back to heuristics on LLM failure

# ─── Priority Engine Weights ──────────────────────────────────────
PRIORITY_SENTIMENT_WEIGHT=0.30
PRIORITY_CATEGORY_WEIGHT=0.25
PRIORITY_TIER_WEIGHT=0.25
PRIORITY_KEYWORD_WEIGHT=0.20
PRIORITY_DUPLICATE_THRESHOLD=0.92      # Cosine similarity threshold for duplicates

# ─── Agentic Engine ───────────────────────────────────────────────
AGENT_MONITOR_INTERVAL_SECONDS=30      # MonitorAgent poll interval
AGENT_ANOMALY_WINDOW_HOURS=24          # Anomaly detection rolling window
AGENT_ANOMALY_ZSCORE_THRESHOLD=2.5     # Z-score threshold for spike detection
AGENT_ESCALATION_TIMEOUT_MINUTES=30    # Auto-escalate if unacknowledged

# ─── Integration: Jira ────────────────────────────────────────────
# TODO(production): Set real Jira credentials
JIRA_ENABLED=false
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=ENG

# ─── Integration: Linear ──────────────────────────────────────────
# TODO(production): Set real Linear credentials
LINEAR_ENABLED=false
LINEAR_API_KEY=
LINEAR_TEAM_ID=

# ─── Integration: Slack ───────────────────────────────────────────
# TODO(production): Set real Slack credentials
SLACK_ENABLED=false
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=#engageai-alerts
SLACK_ESCALATION_CHANNEL=#engageai-incidents

# ─── Integration: Email ───────────────────────────────────────────
# TODO(production): Set real SMTP credentials
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@engageai.io

# ─── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_DEFAULT=100/minute           # Default rate limit per IP
RATE_LIMIT_INGESTION=50/minute          # Feedback ingestion endpoint limit
RATE_LIMIT_AUTH=20/minute               # Login/register endpoint limit

# ─── CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
